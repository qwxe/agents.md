{
  "permissions": {
    "allow": [
      "Bash(git worktree remove .wt/*)",
      "Bash(git worktree remove /home/asd/LLMServingSim/.wt/*)",
      "Bash(git worktree prune)",
      "Bash(unlink .wt/*)",
      "Bash(unlink /home/asd/LLMServingSim/.wt/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify_stop.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
